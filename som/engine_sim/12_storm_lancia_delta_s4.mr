import "engine_sim.mr"

// Storm (Lancia): Lancia Delta S4 1.8 [I4, rali]
// 1759 cc, taxa 11:1, marcha lenta ~1000 rpm, corte 8400 rpm, alvo ~417 cv
// ordem de ignicao 1-3-4-2, intervalos 180/180/180/180 graus
// gerado por tools/gerar_motores.py (mexer la e gerar de novo)

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

private node lancia_s4_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 44 * units.cc;
    input intake_runner_volume: 149.6 * units.cc;
    input intake_runner_cross_section_area: 1.55 * units.inch * 1.55 * units.inch;
    input exhaust_runner_volume: 50.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.35 * units.inch * 1.35 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 83 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 149 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 225 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 309 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 359 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 386 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 403 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 403 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 405 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 405 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 405 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 405 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 46 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 90 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 141 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 200 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 245 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 277 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 294 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 306 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 308 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 308 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 308 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 308 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node lancia_s4_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 114 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 1.0 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;

    camshaft_parameters params (
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)

    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * units.deg) // 1
        .add_lobe(rot360 - exhaust_lobe_center + 540 * units.deg) // 2
        .add_lobe(rot360 - exhaust_lobe_center + 180 * units.deg) // 3
        .add_lobe(rot360 - exhaust_lobe_center + 360 * units.deg) // 4
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * units.deg) // 1
        .add_lobe(rot360 + intake_lobe_center + 540 * units.deg) // 2
        .add_lobe(rot360 + intake_lobe_center + 180 * units.deg) // 3
        .add_lobe(rot360 + intake_lobe_center + 360 * units.deg) // 4
}

public node lancia_s4 {
    alias output __out: engine;

    engine engine(
        name: "Lancia Delta S4 1.8 [I4, rali]",
        starter_torque: 70 * units.lb_ft,
        starter_speed: 500 * units.rpm,
        redline: 8400 * units.rpm,
        fuel: fuel(
            energy_density: 87.21 * units.kJ / units.g,
            max_turbulence_effect: 2.5,
            max_burning_efficiency: 0.85
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.2,
        simulation_frequency: 20000
    )

    wires wires()

    label stroke(71.5 * units.mm)
    label bore(88.5 * units.mm)
    label rod_length(133 * units.mm)
    label rod_mass(450 * units.g)
    label compression_height(1 * units.inch)
    label crank_mass(11 * units.kg)
    label flywheel_mass(4 * units.kg)
    label flywheel_radius(5 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment( // comando, polias etc [estimado]
        disk_moment_of_inertia(mass: 10 * units.kg, radius: 6.0 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 1.5 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 180 * units.deg)
    rod_journal rj2(angle: 180 * units.deg)
    rod_journal rj3(angle: 0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: 330 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake0(
        plenum_volume: 1.3 * units.L,
        plenum_cross_section_area: 20.0 * units.cm2,
        intake_flow_rate: k_carb(1125),
        runner_flow_rate: k_carb(360),
        runner_length: 9 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.999307, // maior = marcha lenta mais baixa
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params0(
        outlet_flow_rate: k_carb(1200),
        primary_tube_length: 14 * units.inch,
        primary_flow_rate: k_carb(400),
        velocity_decay: 1.0
    )
    exhaust_system exhaust0(
        es_params0,
        audio_volume: 6,
        length: 60 * units.inch,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params1(
        outlet_flow_rate: k_carb(1200),
        primary_tube_length: 14 * units.inch,
        primary_flow_rate: k_carb(400),
        velocity_decay: 1.0
    )
    exhaust_system exhaust1(
        es_params1,
        audio_volume: 8,
        length: 61 * units.inch,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake0,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 3 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake0,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            primary_length: 3 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake0,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire3,
            primary_length: 3 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake0,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            primary_length: 3 * units.inch
        )
        .set_cylinder_head(
            lancia_s4_head(
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0,
                flip_display: false)
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 248 * units.deg,
        gamma: 1,
        lift: 440 * units.thou,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 244 * units.deg,
        gamma: 1,
        lift: 420 * units.thou,
        steps: 100
    )

    lancia_s4_camshaft camshaft(
        lobe_profile: "N/A",

        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 108 * units.deg,
        exhaust_lobe_center: 110 * units.deg,
        base_radius: 0.65 * units.inch
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 12 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 19.3 * units.deg)
        .add_sample(3000 * units.rpm, 26.7 * units.deg)
        .add_sample(4000 * units.rpm, 34 * units.deg)
        .add_sample(5000 * units.rpm, 34 * units.deg)
        .add_sample(6000 * units.rpm, 34 * units.deg)
        .add_sample(7000 * units.rpm, 34 * units.deg)
        .add_sample(8000 * units.rpm, 34 * units.deg)
        .add_sample(9000 * units.rpm, 34 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 8600 * units.rpm,
        limiter_duration: 0.05)
    ignition_module
            .connect_wire(wires.wire1, 0 * units.deg)
            .connect_wire(wires.wire3, 180 * units.deg)
            .connect_wire(wires.wire4, 360 * units.deg)
            .connect_wire(wires.wire2, 540 * units.deg)

    engine.add_ignition_module(ignition_module)
}

private node lancia_s4_buggy {
    alias output __out:
        vehicle(
            mass: 1100 * units.kg,
            drag_coefficient: 0.45,
            cross_sectional_area: (70 * units.inch) * (60 * units.inch),
            diff_ratio: 7.1,
            tire_radius: 15 * units.inch,
            rolling_resistance: 300 * units.N
        );
}

private node lancia_s4_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 260 * units.lb_ft
        )
        .add_gear(3.085)
        .add_gear(2.017)
        .add_gear(1.508)
        .add_gear(1.203)
        .add_gear(1);
}

public node main {
    run(
        engine: lancia_s4(),
        transmission: lancia_s4_transmission(),
        vehicle: lancia_s4_buggy()
    )
}

main()
